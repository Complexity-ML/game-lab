{
  "name": "@game-lab/minecraft-mineflayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Structured private-server Minecraft adapter for GAME LAB.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node --env-file-if-exists=.env dist/index.js",
    "test": "npm run build && node --test dist/**/*.node-test.js"
  },
  "dependencies": {
    "minecraft-data": "https://github.com/Complexity-ML/node-minecraft-data-26.2/releases/download/complexity-26.2.2/minecraft-data-complexity-26.2.2.tgz",
    "mineflayer": "https://github.com/Complexity-ML/mineflayer-26.2/releases/download/complexity-26.2.0/mineflayer-complexity-26.2.0.tgz",
    "mineflayer-pathfinder": "2.4.5",
    "vec3": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
